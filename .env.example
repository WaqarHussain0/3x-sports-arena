# MongoDB Atlas connection string (must be a replica set — Atlas is — because bookings use transactions)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/3x-sports-arena?retryWrites=true&w=majority"

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Only needed outside Vercel if the app runs behind a proxy with a different host:
# AUTH_URL="http://localhost:3000"

# Seed admins (scripts/seed-data.ts). Add SEED_ADMIN_2_* etc. for more admins.
SEED_ADMIN_1_NAME="Arena Admin"
SEED_ADMIN_1_EMAIL="admin@3xsportsarena.pk"
SEED_ADMIN_1_PASSWORD=""
